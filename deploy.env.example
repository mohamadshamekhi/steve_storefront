# Copy this file to deploy.env (gitignored) and fill in real values.
# Leave SERVER_PASS empty to use a plain SSH key/agent instead of sshpass.

SERVER_USER=root
SERVER_IP=
SERVER_PASS=
SERVER_PORT=22

# Path to the docker-compose stack on the server (the one that owns the
# `web` service and the shared steve_app_steve_network).
REMOTE_ROOT=/root/project/steve-web

# Tag built on the server and expected by the server-side docker-compose stack.
IMAGE_NAME=web:latest

# Service name in REMOTE_ROOT's docker-compose file, used for the post-deploy
# log-based smoke test (`docker compose logs <name>`).
APP_SERVICE_NAME=steve-storefront
