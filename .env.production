# Torob API v3 integration (src/app/api/torob/products/route.ts)
# Torob's public key (EdDSA) is hardcoded as the default in route.ts.
# Only set this if Torob ever rotates their key and you need to override it
# without a redeploy:
# TOROB_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"


